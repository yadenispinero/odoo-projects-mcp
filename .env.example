# Keep the service bound to localhost unless it is behind an authenticated HTTPS proxy.
MCP_BIND=127.0.0.1
MCP_PORT=8000
ODOO_INSTANCES_FILE=./odoo-instances.json

# Put the Odoo API key in your local, ignored .env file; never commit that file.
ODOO_TESTING_API_KEY=

# Separate random bearer token per MCP user; use at least 32 characters each.
MCP_TOKEN_OWNER=
MCP_TOKEN_N8N=
MCP_USERS_CONFIG_FILE=./mcp-users.json
