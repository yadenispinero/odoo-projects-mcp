# Copy to the project-root .env. This file only configures Compose paths and ports.
# For an external private directory, set MCP_CONNECTIONS_DIR to its absolute path.
MCP_CONNECTIONS_DIR=./local
# 0.0.0.0 publishes /mcp to the local network (plain HTTP: only on a trusted network).
MCP_BIND=127.0.0.1
MCP_PORT=8000
# Admin page port; always published on 127.0.0.1 only.
MCP_ADMIN_PORT=8001
